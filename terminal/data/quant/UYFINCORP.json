},"business":{"ok":true,"is_bank":true,"flags":[{"label":"Business quality","value":19.7,"unit":"/100","status":"weak","read":"Low-quality (20/100).","meaning":"Composite of profitability, return on capital, balance-sheet safety and cash conversion (the Fundamentals-tab Quality score).","why_useful":"A durable, high-return business compounds value; a low-quality one needs a bigger margin of safety.","why_it_can_fail":"A single composite can mask a weak component; open the Fundamentals tab for the breakdown."},{"label":"Cash conversion","value":null,"unit":"\u00d7","status":"na","read":null,"meaning":"Operating cash flow is not a meaningful concept for a lender (deposits & loans dominate the cash statement).","why_useful":"For banks, earnings quality is read from asset quality / provisioning instead (not in MVP-1).","why_it_can_fail":null},{"label":"Balance-sheet safety","value":null,"unit":"","status":"na","read":null,"meaning":"A bank is structurally levered (deposits are its raw material); D/E & interest-cover don't apply.","why_useful":"Read bank safety from capital adequacy (CAR) and NPAs instead (not in MVP-1).","why_it_can_fail":null},{"label":"Earnings momentum","value":-103.86,"unit":"% YoY","status":"weak","read":"Profit down 104% YoY (latest TTM).","meaning":"Trailing-twelve-month net profit vs the year-ago TTM (and whether the YoY rate is rising = 'accelerating').","why_useful":"Improving, accelerating earnings tend to drive re-rating; falling profit warns of a deteriorating business.","why_it_can_fail":"TTM can be lumpy for cyclicals/one-offs; cross-check the multi-year trend on the Fundamentals tab."}]},"valuation":{"ok":true,"is_bank":true,"pe_now":37.8,"pe_percentile":68.0,"median_pe":14.8,"earnings_yield_pct":2.65,"pb":1.13,"ev_ebitda":null,"quality_score":20.0,"pat_cagr_5y_pct":-6.7,"peg":null,"cheapness":{"status":"ok","read":"P/E at the 68-percentile of its 10-yr range \u2014 mid-range vs its own history."},"expectations":null,"cyclical_caveat":nu