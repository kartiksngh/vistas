.13,70.72,69.15,70.29,71.72,74.45,75.79,76.58,76.42,77.21,74.52,71.81,72.24,71.26,73.44,74.51,75.57,75.35,73.94,73.87,72.81,74.8,75.94,73.75,71.79,71.05,71.07,72.46,72.94,72.65,75.33,76.75,74.91,76.39,76.6,75.68,78.97,81.18,83.74,82.44,84.03,83.6,83.74,83.75,83.45,82.71,82.28,80.89,82.33,81.73,82.69,84.02,83.8,83.5,85.11,86.5,85.79,86.86,84.8,81.39,81.8,83.29,83.2,82.21,84.53,84.33,85.73,83.96,82.69,83.24,82.71,82.04,81.2,81.12,81.05,80.69,83.95,82.91,80.53,81.49,77.82,79.55,78.6,79.19,81.23,81.28,80.8,78.89,78.25,79.25,79.94,82.54,83.01,76.21,79.59,74.5,81.25,79.09,79.22,79.17,79.95,84.06]}}},"industry":null,"sector_index":null,"rs_sector":null,"formulas":{"returns":"Trailing point return = price[t] / price[t-N] - 1 (N = 21/63/126/252 trading days); adjusted total-return prices.","dist_from_52w_high":"price[t] / max(price, last 252d) - 1 (how far below the 1-year peak).","dma":"price[t] / mean(price, last N days) - 1; 'above' = price >= the N-day average.","drawdown":"current = price[t]/running-peak - 1; maxDD = min(price/cummax - 1) over the window.","liquidity":"median daily traded value (turnover \u00f7 1e7 = \u20b9 cr) over the last ~21 trading days.","relative_strength":"horizon: stock return - benchmark return (pp); line: (stock/benchmark) rebased to 100 over the last year."},"notes":{"source":"adjusted total-return price panel (bhavcopy-reconstructed) + NSE index TR + bhavcopy turnover.","frequency":"daily","confidence":"high where history is long; flagged low if thin/short.","why_useful":"what the market is saying about the stock \u2014 trend, leadership vs the index/sector, and tradeability.","why_it_can_fail":"corporate-action gaps, illiquid names, or a short listing history can distort returns/DMA/RS."}},"business":{"ok":false,"na":"no fundamentals for this symbol"},"valuation":{"ok":false,"na":"no fundamentals for this symbol"},"ownership":{"ok":false,"na":"no shareholding table cached for this symbol","holders":{},"pledge":null,"events":[],"placeholders":[{"label":"Promoter pledge (detail)","note":"share-level pledge history \u2014 fetchable via NSE, deferred to MVP-2."},{"label":"Bulk / block deals","note":"large on-market trades \u2014 NSE feed, deferred to MVP-2."},{"label":"Insider / SAST disclosures","note":"promoter & designated-person dealings \u2014 deferred to MVP-2."},{"label":"Exchange announcements","note":"NSE/BSE filings stream \u2014 deferred to MVP-2."},{"label":"Results calendar","note":"next board-meeting / results date \u2014 deferred to MVP-2."},{"label":"Credit ratings","note":"rating-agency actions \u2014 deferred to MVP-2."}]},"snapshot":{"dimensions":{"Market":{"verdict":"positive","score":3,"drivers":["+ Trades above its 200-day average (+8%).","+ 50-day average above the 200-day (golden cross).","+ Outpacing the NIFTY 500 by +68pp over 12 months."],"rule":"Points: +1 price above its 200-day average \u00b7 +1 a golden cross (50-day \u2265 200-day) \u00b7 +1 within 10% of the 52-week high \u00b7 +1 beating the NIFTY 500 over 12 months; \u22121 for each opposite, and \u22121 if more than 25% below its peak. Verdict: positive at +2 or more, negative at \u22122 or less, otherwise neutral. The Market signals (above 200-DMA, golden cross, near 52-week high, beating the index) are CORRELATED facets of ONE trend, not independent confirmations \u2014 read the Market verdict as trend-strength, not a tally of independent votes."},"Business":{"verdict":"insufficient","score":null,"drivers":[],"rule":"Points across the four business flags: +1 for each that is 'good' (quality, cash conversion, balance-sheet safety, earnings momentum), \u22121 for each that is 'weak'. Verdict: positive at +2 or more, negative at \u22122 or less."},"Valuation":{"verdict":"insufficient","score":null,"drivers":[],"rule":"Cheap \u2014 P/E below the 30th percentile of its own 10-year range \u2014 scores +2 (supportive); expensive (above the 70th) scores \u22122; mid-range is 0. A peak/cyclical-earnings flag discounts a cheap read to +1. NOTE: 'positive' means the multiple looks supportive vs the stock's OWN history \u2014 it is NOT a buy call."},"Ownership":{"verdict":"insufficient","score":null,"drivers":[],"rule":"Points: +1 promoter stake rising \u00b7 \u22121 promoter stake falling more than 1pp in a year \u00b7 \u22121 promoter pledge above 10% \u00b7 +1 for each of FII / DII accumulating (>0.5pp in a year). Verdict: positive at +1 or more, negative at \u22121 or less."}},"top_positives":["Trades above its 200-day average (+8%).","50-day average above the 200-day (golden cross).","Outpacing the NIFTY 500 by +68pp over 12 months."],"key_risks":[],"monitor_next":["Next quarterly results (board-meeting date is an MVP-2 placeholder).","Relative-strength inflection vs its sector index."],"caveats":["corporate-action gaps, illiquid names, or a short listing history can distort returns/DMA/RS."],"confidence":"low","disclaimer":"Diagnostics only \u2014 a structured reading of price behaviour, business fundamentals, valuation and ownership for your OWN judgement. This is NOT a buy/sell/hold recommendation.","method":"Each dimension is a transparent points tally of the named signals listed beneath it \u2014 open a dimension to see the exact signals that fired and its rule. Verdict = positive at +2 or more / negative at \u22122 or less for Market, Business and Valuation; \u00b11 for Ownership. A 'positive' valuation means the multiple looks supportive vs the stock's OWN history \u2014 never a buy call."},"data_quality":{"price_asof":"2004-05-28","fundamentals_fetched":"2026-07-15","has_fundamentals":false,"has_shareholding":false,"liquidity_warning":null,"note":"Market data is daily and current; fundamentals & shareholding are as of the last cached Screener fetch (quarterly/annual). Confidence is lower for thin or short-history names."}}