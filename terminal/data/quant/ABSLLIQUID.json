]}}},"industry":null,"sector_index":null,"rs_sector":null,"formulas":{"returns":"Trailing point return = price[t] / price[t-N] - 1, where N is 30/91/182/365 CALENDAR days and the anchor is the last close on or before that date (at most 7 days older). Shown as \u2014 with a reason when the stock was not trading then, so a 12M figure is always a 12-month figure. Adjusted total-return prices.","dist_from_52w_high":"price[t] / max(price over the last 365 CALENDAR days) - 1 (how far below the 1-year peak); needs at least 60 prices in that year.","dma":"price[t] / mean(price, last N days) - 1; 'above' = price >= the N-day average.","drawdown":"current = price[t]/running-peak - 1; maxDD = min(price/cummax - 1) over the window.","liquidity":"median daily traded value (turnover \u00f7 1e7 = \u20b9 cr) over the last ~21 trading days.","relative_strength":"horizon: stock return - benchmark return (pp); line: (stock/benchmark) rebased to 100 over the last year."},"notes":{"source":"adjusted total-return price panel (bhavcopy-reconstructed) + NSE index TR + bhavcopy turnover.","frequency":"daily","confidence":"high where history is long; flagged low if thin/short.","why_useful":"what the market is saying about the stock \u2014 trend, leadership vs the index/sector, and tradeability.","why_it_can_fail":"corporate-action gaps, illiquid names, or a short listing history can distort returns/DMA/RS."}},"business":{"ok":false,"na":"no fundamentals for this symbol"},"valuation":{"ok":false,"na":"no fundamentals for this symbol"},"ownership":{"ok":false,"na":"no shareholding table cached for this symbol","holders":{},"pledge":null,"events":[],"placeholders":[{"label":"Promoter pledge (detail)","note":"share-level pledge history \u2014 fetchable via NSE, deferred to MVP-2."},{"label":"Bulk / block deals","note":"large on-market trades \u2014 NSE feed, deferred to MVP-2."},{"label":"Insider / SAST disclosures","note":"promoter & designated-person dealings \u2014 deferred to MVP-2."},{"lab